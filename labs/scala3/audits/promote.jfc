<?xml version="1.0" encoding="UTF-8"?>
<configuration version="2.0" label="promotion census" description="G1 copies at young GCs: class, size, age, tenured; plus GC events">
  <event name="jdk.PromoteObjectInNewPLAB"><setting name="enabled">true</setting></event>
  <event name="jdk.PromoteObjectOutsidePLAB"><setting name="enabled">true</setting></event>
  <event name="jdk.GarbageCollection"><setting name="enabled">true</setting><setting name="threshold">0 ms</setting></event>
  <event name="jdk.G1HeapSummary"><setting name="enabled">true</setting></event>
  <event name="jdk.TenuringDistribution"><setting name="enabled">true</setting></event>
</configuration>
