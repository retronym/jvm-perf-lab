# Where the uniques prototype's `mapParams` weak scope is entered from (retronym/scala#240, claude/uniques-audit-2.13.x).
# The scope covers TypeMap.mapOver(List[Symbol]): the map applied to each param's info, and, when one changes, the
# params cloned and their infos mapped (mapOverSyms -> cloneSymbols). MethodType.mapOver and PolyType.mapOver enter it
# too, around the substSym of the result onto the cloned params.

# every entry, by area of the compiler (first label whose frame is on the stack)
count  mp       at=scala.reflect.internal.tpe.TypeMaps$TypeMap#mapOver(Lscala/collection/immutable/List;  onStack=matches:scala.reflect.internal.Types#matchesType,subtype:scala.reflect.internal.tpe.TypeComparers#isSubType,sameType:scala.reflect.internal.tpe.TypeComparers#isSameType,asSeenFrom:scala.reflect.internal.Types$Type#asSeenFrom,memberType:scala.reflect.internal.Types$Type#memberType,instantiate:scala.reflect.internal.Types$Type#instantiateTypeParams,implicits:scala.tools.nsc.typechecker.Implicits$ImplicitSearch,infer:scala.tools.nsc.typechecker.Infer$Inferencer,namer:scala.tools.nsc.typechecker.Namers,typer:scala.tools.nsc.typechecker.Typers,refchecks:scala.tools.nsc.typechecker.RefChecks,erasure:scala.tools.nsc.transform.Erasure,specialize:scala.tools.nsc.transform.SpecializeTypes,uncurry:scala.tools.nsc.transform.UnCurry,mixin:scala.tools.nsc.transform.Mixin

# which type map
sites  mp-map   at=scala.reflect.internal.tpe.TypeMaps$TypeMap#mapOver(Lscala/collection/immutable/List;  depth=0  qualify=class

# the code outside the type-map machinery that asked for the mapping
sites  mp-ctx   at=scala.reflect.internal.tpe.TypeMaps$TypeMap#mapOver(Lscala/collection/immutable/List;  depth=4  sample=20  qualify=class  skip=^(scala\.reflect\.internal\.(tpe\.TypeMaps|Types\$(Type|TypeRef|MethodType|PolyType|ExistentialType|NullaryMethodType|AnnotatedType|RefinedType|ClassInfoType|TypeBounds|SingleType|AliasTypeRef|AbstractTypeRef|ArgsTypeRef|ClassTypeRef|ModuleTypeRef|NoArgsTypeRef)|Types\.|SymbolTable\.)|scala\.collection\.)

# the subset that clones params (some param's info changed): mapOverSyms calling cloneSymbols, by area and context
count  clone     at=scala.reflect.internal.SymbolTable#cloneSymbols(Lscala/collection/immutable/List;)  from=scala.reflect.internal.tpe.TypeMaps$TypeMap#mapOverSyms  onStack=matches:scala.reflect.internal.Types#matchesType,subtype:scala.reflect.internal.tpe.TypeComparers#isSubType,sameType:scala.reflect.internal.tpe.TypeComparers#isSameType,asSeenFrom:scala.reflect.internal.Types$Type#asSeenFrom,memberType:scala.reflect.internal.Types$Type#memberType,instantiate:scala.reflect.internal.Types$Type#instantiateTypeParams,implicits:scala.tools.nsc.typechecker.Implicits$ImplicitSearch,infer:scala.tools.nsc.typechecker.Infer$Inferencer,namer:scala.tools.nsc.typechecker.Namers,typer:scala.tools.nsc.typechecker.Typers,refchecks:scala.tools.nsc.typechecker.RefChecks,erasure:scala.tools.nsc.transform.Erasure,specialize:scala.tools.nsc.transform.SpecializeTypes,uncurry:scala.tools.nsc.transform.UnCurry,mixin:scala.tools.nsc.transform.Mixin
sites  clone-ctx at=scala.reflect.internal.SymbolTable#cloneSymbols(Lscala/collection/immutable/List;)  from=scala.reflect.internal.tpe.TypeMaps$TypeMap#mapOverSyms  depth=4  sample=5  skip=^(scala\.reflect\.internal\.(tpe\.TypeMaps|Types\$(Type|TypeRef|MethodType|PolyType|ExistentialType|NullaryMethodType|AnnotatedType|RefinedType|ClassInfoType|TypeBounds|SingleType|AliasTypeRef|AbstractTypeRef|ArgsTypeRef|ClassTypeRef|ModuleTypeRef|NoArgsTypeRef)|Types\.|SymbolTable\.)|scala\.collection\.)
