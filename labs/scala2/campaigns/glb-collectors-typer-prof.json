{
  "name": "glb-collectors-typer-prof",
  "description": "scala/scala#11314: cpu profiles of each build in its own fork, typer only, for profdiff",
  "benchmark": "CompileBenchmark",
  "profile": "async:cpu",
  "rounds": 1,
  "corpora": {
    "re2s": "-wi 10 -i 10 -w 3 -r 3 -p scalacOptions=-Ystop-after:typer"
  },
  "variants": {"base": "", "pr": ""},
  "variantJmhArgs": {"base": "-p variants=base=@build=../glb-base", "pr": "-p variants=pr=@build=."},
  "gcLog": true,
  "jvmArgs": "-Xms4G -Xmx4G -Xss2M -XX:ReservedCodeCacheSize=1g -XX:-UseCodeCacheFlushing"
}
