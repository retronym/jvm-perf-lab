<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>io.github.retronym.perflab</groupId><artifactId>jvm-perf-lab</artifactId><version>0.1.0-SNAPSHOT</version></parent>
  <artifactId>perflab-agent</artifactId>
  <description>Caller audits: probes woven into a program as it loads, counting which callers reach a method</description>
  <dependencies>
    <dependency><groupId>org.ow2.asm</groupId><artifactId>asm</artifactId></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build>
    <plugins>
      <!-- one jar to pass to -javaagent: ASM inside, relocated so it cannot clash with the program's own ASM -->
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <executions><execution><phase>package</phase><goals><goal>shade</goal></goals>
          <configuration>
            <createDependencyReducedPom>true</createDependencyReducedPom>
            <dependencyReducedPomLocation>${project.build.directory}/dependency-reduced-pom.xml</dependencyReducedPomLocation>
            <relocations><relocation><pattern>org.objectweb.asm</pattern><shadedPattern>io.github.retronym.perflab.shaded.asm</shadedPattern></relocation></relocations>
            <transformers>
              <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                <manifestEntries><Premain-Class>io.github.retronym.perflab.audit.AuditAgent</Premain-Class></manifestEntries>
              </transformer>
            </transformers>
          </configuration></execution></executions>
      </plugin>
    </plugins>
  </build>
</project>
